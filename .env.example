# URL of DSM, with the HTTPS port (5001 by default)
SYNO_URL=https://192.168.1.10:5001

# Dedicated DSM account for the agent (administrators group needed for containers and shared folders)
SYNO_USERNAME=mcp-agent
SYNO_PASSWORD=

# Any SYNO_<NAME> can instead come from a command printing the value, e.g. from a password manager:
# SYNO_USERNAME_COMMAND=op read "op://Private/Synology MCP/username"     (1Password CLI)
# SYNO_PASSWORD_COMMAND=bw get password synology-mcp                     (Bitwarden CLI)
# SYNO_PASSWORD_COMMAND=pass show nas/mcp                                (pass)

# 2FA (DSM usually enforces it for administrators), pick one:
#   a) a command printing a fresh code, run at each login
# SYNO_OTP_COMMAND=op read "op://Private/Synology MCP/one-time password?attribute=otp"
#   b) the TOTP secret (base32, or the otpauth:// URI of the QR code); codes are computed locally
# SYNO_TOTP_SECRET=
#   c) a device token, obtained once with `bun run device-token <otp>`
SYNO_DEVICE_ID=
# SYNO_DEVICE_NAME=SynologyMCP

# What each part of the server may do (off / ro / rw) is set in data/permissions.yml,
# created read-only on first start. Another location:
# SYNO_PERMISSIONS_FILE=./data/permissions.yml

# Accept DSM's self-signed certificate (only on a trusted LAN)
SYNO_INSECURE_TLS=false

# Optional: append every write/destructive action to this file (JSON lines)
# SYNO_AUDIT_LOG=./audit.log

# SYNO_TIMEOUT_MS=30000
# SYNO_DEBUG=false
# SYNO_SESSION=webui
